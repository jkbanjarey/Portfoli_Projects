# Use the supplied zip directly. It is extracted once to data/ on first query.
PAYSIM_DATASET_PATH=PaySim_Dataset.zip

# Create a project API key at https://platform.openai.com/api-keys.
# Do not commit the real key or expose it in the Streamlit browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MAX_QUERY_ROWS=100
